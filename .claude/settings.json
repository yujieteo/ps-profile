{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git tag *)",
      "Bash(git push origin v*)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git push *refs/tags/*)",
      "Bash(gh release *)",
      "Bash(cp * $PROFILE*)",
      "Bash(cp *WindowsPowerShell*)",
      "Bash(cp *Documents/PowerShell*)",
      "Bash(cp *Documents\\PowerShell*)",
      "Bash(cp */.config/powershell*)",
      "Bash(mv *$PROFILE*)",
      "Bash(mv *WindowsPowerShell*)",
      "Bash(mv *Documents/PowerShell*)",
      "Bash(mv *Documents\\PowerShell*)",
      "Bash(mv */.config/powershell*)",
      "Bash(*tee *$PROFILE*)",
      "Bash(*tee *WindowsPowerShell*)",
      "Bash(*tee *Documents/PowerShell*)",
      "Bash(*tee */.config/powershell*)",
      "Bash(*Copy-Item*$PROFILE*)",
      "Bash(*Copy-Item*WindowsPowerShell*)",
      "Bash(*Copy-Item*Documents/PowerShell*)",
      "Bash(*Copy-Item*Documents\\PowerShell*)",
      "Bash(*Copy-Item*/.config/powershell*)",
      "Bash(*Move-Item*$PROFILE*)",
      "Bash(*Move-Item*WindowsPowerShell*)",
      "Bash(*Move-Item*Documents/PowerShell*)",
      "Bash(*Move-Item*Documents\\PowerShell*)",
      "Bash(*Move-Item*/.config/powershell*)",
      "Bash(*New-Item*$PROFILE*)",
      "Bash(*Set-Content*$PROFILE*)",
      "Bash(*Add-Content*$PROFILE*)",
      "Bash(*Out-File*$PROFILE*)",
      "Bash(*> $PROFILE*)",
      "Bash(*>> $PROFILE*)",
      "Edit(~/Documents/WindowsPowerShell/**)",
      "Edit(~/Documents/PowerShell/**)",
      "Edit(~/OneDrive/Documents/WindowsPowerShell/**)",
      "Edit(~/OneDrive/Documents/PowerShell/**)",
      "Edit(~/.config/powershell/**)"
    ]
  }
}
