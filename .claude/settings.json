{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git tag *)",
      "Bash(git push origin v*)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(gh release *)",
      "Bash(cp * $PROFILE*)",
      "Bash(cp *WindowsPowerShell*)",
      "Bash(cp */.config/powershell*)",
      "Bash(*Copy-Item*$PROFILE*)",
      "Bash(*Copy-Item*WindowsPowerShell*)",
      "Bash(*Copy-Item*/.config/powershell*)",
      "Bash(*Set-Content*$PROFILE*)",
      "Bash(*Out-File*$PROFILE*)",
      "Bash(*> $PROFILE*)",
      "Bash(*>> $PROFILE*)",
      "Edit(~/Documents/WindowsPowerShell/**)",
      "Edit(~/OneDrive/Documents/WindowsPowerShell/**)",
      "Edit(~/.config/powershell/**)"
    ]
  }
}
